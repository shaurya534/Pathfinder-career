# Anthropic API key used for resume analysis, tutoring, roadmap generation,
# lesson generation and mock interviews.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Database. Defaults to a local SQLite file so the app runs with zero setup.
# For production, swap to Postgres, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/career_ai?schema=public"
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string

# ---- Not wired to a live provider yet (see README "What's stubbed") ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
